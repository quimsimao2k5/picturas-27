# Copy to .env and edit to override the defaults in docker-compose.yaml.
# .env is git-ignored: keep real credentials there, never in the compose file.
# Every variable below has a working default, so the stack runs without a .env.

# --- Object storage (SeaweedFS S3) ---
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_KEK_PASSPHRASE=picturas-kek-passphrase-change-me
