%% Adaptado de arquitetura_global.puml (equipa docente, 5/11/2026): mesma estrutura e cores;
%% acrescentadas as fragilidades medidas na base (F1-F3, F7) e o resumo das medições.
%%{init: {"flowchart": {"defaultRenderer": "elk", "curve": "basis"}, "themeVariables": {"fontSize": "14px"}}}%%
flowchart TB
  browser["Browser<br/>(Next.js SPA)"]

  subgraph edge["Entrada única · HTTPS :8080"]
    nginx["nginx<br/>TLS + reverse proxy<br/>client_max_body_size 1100 MB"]
  end

  subgraph access["Camada de acesso"]
    frontend["frontend<br/>Next.js :3000"]
    gw["API Gateway :8000<br/>Express · JWT<br/>multer.memoryStorage"]
    wsgw["WS Gateway :4000<br/>Socket.IO · JWT"]
  end

  subgraph business["Serviços de negócio"]
    projects["projects :9001 · ORQUESTRADOR<br/>pipelines · Process/Result · tokens<br/>routes/projects.js, 2 732 linhas"]
    users["users :10001"]
    subs["subscriptions :11001"]
    storage["img_storage :11000<br/>façade S3 · multer.memoryStorage"]
    pdb[("MongoDB<br/>projects")]
  end

  s3[("SeaweedFS (S3)<br/>src · out · preview")]

  subgraph rmq["RabbitMQ · exchange direto «picturas» · filas duráveis"]
    toolq[["&lt;tool&gt;_queue<br/>(16 filas de imagem)"]]
    videoq[["video_queue"]]
    projq[["project_queue<br/>(respostas)"]]
    wsq[["ws_queue<br/>(eventos para a UI)"]]
  end

  subgraph workers["Workers (consomem filas)"]
    imgtools["16 ferramentas de imagem<br/>1 contentor por fila · auto-ack<br/>PIL / IA"]
    videotool["video_tool · 1 contentor, sem réplicas<br/>ffmpeg + PIL por fotograma + Faster-Whisper<br/>efeitos · legendagem · extração<br/>prefetch = 1 · ack no fim"]
  end

  vol[/"volume partilhado<br/>image_data (/app/images)"/]

  f1["F1 · Capacidade / elasticidade<br/>1 vídeo de cada vez (S2: débito 16,8 vídeos/min com 8 utilizadores)<br/>vídeo de 10 s espera 141 s atrás de uma legendagem (S1)<br/>1 réplica sob rajada, 9 vídeos à espera (S3)"]
  f2["F2 · Modularidade<br/>3 funcionalidades de vídeo numa só unidade (M2)<br/>mudar a legendagem interrompe as 3 (M1)<br/>falha na legendagem atrasa 100 % dos outros vídeos (M3)"]
  f2b["F2 · Ramificação imagem/vídeo<br/>no orquestrador (EV-07, EV-21)"]
  f3["F3 · Vídeo de até 1 GB<br/>inteiro em memória em 3 serviços (EV-15)"]
  f7["F7 · auto-ack: trabalho de imagem<br/>perde-se se o worker cair (EV-10)"]

  browser --> nginx
  nginx --> frontend
  nginx -- "/api-gateway/" --> gw
  nginx -- "/socket.io" --> wsgw
  nginx -- "/s3/" --> s3
  gw -- REST --> projects
  gw --> users
  gw --> subs
  projects --- pdb
  storage --> s3
  projects -- "1 msg por (imagem, ferramenta)" --> toolq
  toolq --> imgtools
  imgtools --> projq
  projq -- "avança a cadeia" --> projects
  projects --> wsq
  wsq --> wsgw
  projects -.- vol
  imgtools -.- vol

  gw == "POST …/video (buffer em memória)" ==> projects
  projects ==> storage
  projects == "1 msg por vídeo (pipeline completo)" ==> videoq
  videoq ==> videotool
  videotool == resultado ==> projq
  videotool == "video-progress (%)" ==> wsq
  videotool -.- vol

  f1 -.- videotool
  f2 -.- videotool
  f2b -.- projects
  f3 -.- gw
  f7 -.- imgtools

