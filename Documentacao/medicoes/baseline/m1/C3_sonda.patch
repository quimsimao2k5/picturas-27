@@ -0,0 +1,26 @@
+import { useState } from "react";
+import { Palette } from "lucide-react";
+import { ToolbarButton } from "./toolbar-button";
+import { useCurrentImage } from "@/providers/project-provider";
+import { isVideo } from "@/lib/projects";
+
+/** Probe C3 (never merged): project-wide sepia effect for every video. */
+export default function SepiaTool({ disabled }: { disabled: boolean }) {
+  const [open, setOpen] = useState(false);
+  const currentImage = useCurrentImage();
+  return (
+    <ToolbarButton
+      open={open}
+      setOpen={setOpen}
+      tool={{ procedure: "sepia", params: {} }}
+      icon={Palette}
+      label="Sepia"
+      disabled={disabled}
+      previewDisabled={!currentImage || !isVideo(currentImage)}
+    >
+      <p className="max-w-64 text-xs text-muted-foreground">
+        Applies a sepia tone to every video in this project.
+      </p>
+    </ToolbarButton>
+  );
+}
